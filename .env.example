# Copy to .env and fill in. .env is gitignored.
# auto-econ-sentiment reads .env from the working directory when an API key is needed.
# Variables already set in your shell take precedence.

# Only for llm.provider: openai. Used when a model sets no api_key_env.
OPENAI_API_KEY=

# Any name works; point `api_key_env` in params.yaml at it (e.g. api_key_env: OPENROUTER_API_KEY).
OPENROUTER_API_KEY=

# Paper replication only (src/research_paper): fetches the FRED macro series for the VAR.
FRED_API_KEY=
